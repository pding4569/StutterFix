<Project>
  <!-- Measurement-only: the normal Player/Debug build never imports this file. -->
  <ItemGroup>
    <Compile Remove="StutterFix.cs" />
    <Compile Include="$(FrameGenProbeMain)" />
    <Compile Remove="AutoTest.cs" />
    <Compile Include="$(FrameGenProbeAutoTest)" />
    <Compile Include="$(FrameGenProbeSource)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrameGenProbeKind)' == 'InGame'">
    <EmbeddedResource Remove="native/sfnative.dll" />
    <EmbeddedResource Include="$(FrameGenNative)" LogicalName="StutterFix.sfnative.dll" />
  </ItemGroup>
</Project>
