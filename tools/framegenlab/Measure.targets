<Project>
  <PropertyGroup Condition="'$(FrameGenProbeKind)' == 'Outside'">
    <DefineConstants>$(DefineConstants);FRAMEGEN_RESEARCH</DefineConstants>
  </PropertyGroup>
  <!-- Measurement-only: the normal Player/Debug build never imports this file. -->
  <ItemGroup>
    <Compile Remove="StutterFix.cs" />
    <Compile Include="$(FrameGenProbeMain)" />
    <Compile Remove="AutoTest.cs" />
    <Compile Include="$(FrameGenProbeAutoTest)" />
    <Compile Include="$(FrameGenProbeSource)" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrameGenProbeKind)' == 'InGame' Or '$(FrameGenProbeKind)' == 'Outside'">
    <EmbeddedResource Remove="native/sfnative.dll" />
    <EmbeddedResource Include="$(FrameGenNative)" LogicalName="StutterFix.sfnative.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrameGenProbeKind)' == 'Outside'">
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(GameManaged)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
