// ADOFAI 렌더러 B: 구간마다 화면 확대 배율(화면 픽셀 / 텍스처 텍셀)의 최솟값을 구한다. 안 보이는 항목(정점 0)과 화면 밖 항목은 뺀다.
#pragma kernel SpanLodClear
#pragma kernel SpanLod
ByteAddressBuffer _LodVerts;
StructuredBuffer<uint> _LodSpanOfSlot;
RWStructuredBuffer<uint> _LodOut;
// 구간마다 이번 프레임 화면 사각형(픽셀, 위에서 아래): minX,minY,maxX,maxY. 합성 사각형을 이 범위로만 그린다(전체 화면 합성 제거).
RWStructuredBuffer<int> _LodBox;
float4x4 _LodVP;
float4 _LodScreen;
uint _LodSlots;
uint _LodSpans;
[numthreads(64,1,1)]
void SpanLodClear(uint3 t:SV_DispatchThreadID)
{
    uint s=t.x;if(s>=_LodSpans)return;
    _LodOut[s*2]=0x7F7FFFFFu;_LodOut[s*2+1]=0u;
    _LodBox[s*4]=0x7FFFFFFF;_LodBox[s*4+1]=0x7FFFFFFF;_LodBox[s*4+2]=-1;_LodBox[s*4+3]=-1;
}
[numthreads(64,1,1)]
void SpanLod(uint3 t:SV_DispatchThreadID)
{
    uint slot=t.x;if(slot>=_LodSlots)return;
    uint span=_LodSpanOfSlot[slot];if(span>=_LodSpans)return;
    float2 s[4];float2 tx[4];bool nz=false;
    [unroll] for(uint k=0;k<4;k++)
    {
        uint a=(slot*4+k)*60u;float3 p=asfloat(_LodVerts.Load3(a));nz=nz||any(p!=0);
        float4 uvi=asfloat(_LodVerts.Load4(a+28));float4 r=asfloat(_LodVerts.Load4(a+44));
        float4 c=mul(_LodVP,float4(p,1));float2 n=c.xy/c.w;
        s[k]=float2((n.x*0.5+0.5)*_LodScreen.x,(0.5-n.y*0.5)*_LodScreen.y);
        tx[k]=uvi.xy*r.xy/max(2*r.zw,1e-12);
    }
    if(!nz)return;
    float2 lo=min(min(s[0],s[1]),min(s[2],s[3])),hi=max(max(s[0],s[1]),max(s[2],s[3]));
    if(hi.x<0||hi.y<0||lo.x>_LodScreen.x||lo.y>_LodScreen.y)return;
    float mag=3.0e38;
    [unroll] for(uint i=0;i<4;i++)[unroll] for(uint j=i+1;j<4;j++)
    {
        float dt=length(tx[j]-tx[i]);if(dt>0.5)mag=min(mag,length(s[j]-s[i])/dt);
    }
    // 1/4 RT의 선형 확대 필터가 원래 기하 경계 밖으로 퍼지는 부분도 합성한다.
    // 최대 한 저해상도 텍셀(화면 4픽셀)을 확보해 전체 화면 합성과 같은 샘플을 보존한다.
    int2 bl=int2(clamp(floor(lo)-4,0,_LodScreen.xy)),bh=int2(clamp(ceil(hi)+4,0,_LodScreen.xy));
    InterlockedMin(_LodBox[span*4],bl.x);InterlockedMin(_LodBox[span*4+1],bl.y);
    InterlockedMax(_LodBox[span*4+2],bh.x);InterlockedMax(_LodBox[span*4+3],bh.y);
    InterlockedMin(_LodOut[span*2],asuint(mag));
    InterlockedAdd(_LodOut[span*2+1],1u);
}
