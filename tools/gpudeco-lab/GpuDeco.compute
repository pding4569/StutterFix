// Diagnostic only. Sprites/Tile remains the intended game draw shader.
#pragma kernel Evaluate
#pragma kernel EvaluateLive
#pragma kernel EvaluateCollapse
#pragma kernel EvaluateImageLive
#pragma kernel EaseProbe
#pragma kernel CopyRun
#pragma kernel CopyMappedRun
#pragma kernel RotationProbe
#pragma kernel ImageRotationProbe
#pragma kernel ImagePixelProbe
#pragma kernel LinearProbe
#pragma kernel AlphaBounds
#pragma target 5.0

struct Segment { float hi, lo, duration, start, end, target, over, period; uint ease, scale; };
struct Track { uint first, count; float initial; uint pad; };
StructuredBuffer<Segment> _Segments;
StructuredBuffer<Track> _Tracks;
struct Anchor { Segment segment; uint clock, valid; };
StructuredBuffer<Anchor> _Anchors;
StructuredBuffer<float> _Progress;
struct LiveChannel { float start, change, end; int sourceIndex; };
StructuredBuffer<LiveChannel> _LiveChannels;
StructuredBuffer<float> _SourceE;
uint _UseAnchors;
float4 _CameraClip; // (cos, sin, 반폭, 반높이). 반폭 0 이하면 화면 밖 걸러내기 끔
// 10 float4 records per decoration: shape[4], offset origin/X/Y, constants, crop/Z/flags, startRot.
StructuredBuffer<float4> _Static;
// Optional fixed local matrix + original local sprite corners, eight records/item.
StructuredBuffer<float4> _ImageShape;
StructuredBuffer<float2> _UV;
RWStructuredBuffer<float> _Values;
RWByteAddressBuffer _Vertices;
StructuredBuffer<uint> _CollapseMap;
StructuredBuffer<float4> _CollapseTexture;
uint _CollapseCount;
uint _AlphaEarlyOut; // 제품: 1 이면 독립 평가에서도 알파 곱이 0 이하인 항목은 나머지 채널·FP64 계산을 건너뛰고 영 면적으로 둔다
uint _Count;
float _TimeHi, _TimeLo, _Pitch, _TweenScale;
float4 _Camera; // XY, rotation degrees, lock-scale multiplier
StructuredBuffer<float4> _Probe;
StructuredBuffer<uint> _ProbeIds;
RWStructuredBuffer<float> _ProbeOut;
RWStructuredBuffer<float4> _RotationOut;
Texture2D<float4> _ImageDiffA,_ImageDiffB;
RWStructuredBuffer<uint> _ImageDiff;
int4 _ImageDiffRect;
[numthreads(64,1,1)]
void ImagePixelProbe(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x,total=(uint)(_ImageDiffRect.z*_ImageDiffRect.w);if(i>=total)return;
    int2 p=_ImageDiffRect.xy+int2(i%(uint)_ImageDiffRect.z,i/(uint)_ImageDiffRect.z);
    uint4 a=(uint4)(saturate(_ImageDiffA.Load(int3(p,0)))*255+.5),b=(uint4)(saturate(_ImageDiffB.Load(int3(p,0)))*255+.5);
    if(any(a!=b))InterlockedAdd(_ImageDiff[0],1);
    uint4 d=max(a,b)-min(a,b);
    InterlockedMax(_ImageDiff[1],max(max(d.x,d.y),max(d.z,d.w)));
    if(any(a!=0))InterlockedAdd(_ImageDiff[2],1);
    if(any(b!=0))InterlockedAdd(_ImageDiff[3],1);
}
ByteAddressBuffer _CopySource;
uint _CopyFirstVertex, _CopyVertexCount;
uint _CopyQuantizeColor;

float Bounce(float x)
{
    if (x < 1.0/2.75) return 7.5625*x*x;
    if (x < 2.0/2.75) { x -= 1.5/2.75; return 7.5625*x*x+.75; }
    if (x < 2.5/2.75) { x -= 2.25/2.75; return 7.5625*x*x+.9375; }
    x -= 2.625/2.75; return 7.5625*x*x+.984375;
}
// HLSL asin's D3D11 approximation is too loose for DOTween elastic phases.
// Evaluate the reduced asinf rational polynomial and reconstruct above 1/2.
float AsinPhase(float x)
{
    precise float z = x <= .5 ? x*x : (1-x)*.5;
    precise float p = z*(.16666586697+z*(-.042743422091+z*(-.008656363003)));
    precise float r = p/(1+z*(-.70662963390));
    if(x<=.5) return x+x*r;
    precise float s=sqrt(z);
    return 1.5707963705062866-2*(s+s*r);
}
float CpuQuotient(float numerator,float denominator)
{
    // SM5 division uses an approximate reciprocal. Correct the residual and
    // round once, matching the CPU float quotient for polynomial easings too.
    precise float estimate=numerator/denominator;
    precise double residual=(double)numerator-(double)estimate*(double)denominator;
    precise double corrected=(double)estimate+residual*(double)(1.0/denominator);
    return (float)corrected;
}
precise float Ease(uint id, float t, float d, float amplitude, float period)
{
    const float pi = 3.1415927410125732421875;
    precise float x=CpuQuotient(t,d), y;
    if (id==1) return x;
    if (id==2) return 1-cos(x*(pi*.5));
    if (id==3) return sin(x*(pi*.5));
    if (id==4) return -.5*(cos(pi*t/d)-1);
    if (id>=5 && id<=16)
    {
        uint power=2+(id-5)/3, mode=(id-5)%3;
        y=mode==0 ? x : mode==1 ? x-1 : x*2;
        if (mode==2 && y>=1) y-=2;
        float p=y*y;
        if(power>=3) p*=y;
        if(power>=4) p*=y;
        if(power>=5) p*=y;
        if(mode==0) return p;
        if(mode==1) return (power%2==0 ? -p : p)+1;
        return x<.5 ? .5*p : .5*((power%2==0 ? -p : p)+2);
    }
    if(id==17) return t==0 ? 0 : exp2(10*(x-1));
    if(id==18) return t==d ? 1 : 1-exp2(-10*t/d);
    if(id==19) { if(t==0) return 0; if(t==d) return 1; y=t/(d*.5); return y<1 ? .5*exp2(10*(y-1)) : .5*(2-exp2(-10*(y-1))); }
    if(id==20) return t==d ? 1 : 1-sqrt(1-x*x);
    if(id==21) { y=x-1; return sqrt(1-y*y); }
    if(id==22) { if(t==d*.5) return .5; y=t/(d*.5); if(y<1) return -.5*(sqrt(1-y*y)-1); y-=2; return .5*(sqrt(1-y*y)+1); }
    if(id>=23 && id<=25)
    {
        if(t==0) return 0;
        if(t==d) return 1;
        y=id==25 ? t/(d*.5) : x;
        if(y==(id==25 ? 2 : 1)) return 1;
        if(period==0) period=d*(id==25 ? .45000002 : .3);
        precise float phase;
        if(amplitude<1) { amplitude=1; phase=period/4; }
        else phase=period/(pi*2)*AsinPhase(1/amplitude);
        if(id==23) { y-=1; return -amplitude*exp2(10*y)*sin((y*d-phase)*(pi*2)/period); }
        if(id==24) return amplitude*exp2(-10*y)*sin((y*d-phase)*(pi*2)/period)+1;
        bool first=y<1; y-=1;
        return first ? -.5*amplitude*exp2(10*y)*sin((y*d-phase)*(pi*2)/period)
            : .5*amplitude*exp2(-10*y)*sin((y*d-phase)*(pi*2)/period)+1;
    }
    if(id==26) return x*x*((amplitude+1)*x-amplitude);
    if(id==27) { y=x-1; return y*y*((amplitude+1)*y+amplitude)+1; }
    if(id==28) { y=t/(d*.5); amplitude*=1.525; if(y<1) return .5*y*y*((amplitude+1)*y-amplitude); y-=2; return .5*(y*y*((amplitude+1)*y+amplitude)+2); }
    if(id==29) return 1-Bounce((d-t)/d);
    if(id==30) return Bounce(x);
    if(id==31) return t<d*.5 ? (1-Bounce((d-t*2)/d))*.5 : Bounce((t*2-d)/d)*.5+.5;
    if(id==36) return 1;
    // Unset is DOTween's OutQuad default. Flash/custom are rejected before upload.
    return -x*(x-2);
}
float Delta(Segment s) { return (_TimeHi-s.hi)+(_TimeLo-s.lo); }
// D3D11 native sincos loses CPU float rounding on wide sprites. SM5 double
// arithmetic (no double trig intrinsics) keeps range reduction/polynomial
// rounding below a float ULP, then returns the CPU's float quaternion inputs.
float2 RotationSinCos(float x)
{
    int quadrant=(int)round(x*0.63661977236758134);
    precise double r=(double)x-(double)quadrant*1.57079632679489661923L;
    precise double z=r*r;
    precise double sn=r+r*z*(-0.16666666666666666667L+z*(0.00833333333333333333L+z*(-0.00019841269841269841L+z*(0.00000275573192239858907L+z*(-0.00000002505210838544172L+z*0.00000000016059043836821615L)))));
    precise double cs=1.0L+z*(-0.5L+z*(0.04166666666666666667L+z*(-0.00138888888888888889L+z*(0.00002480158730158730L+z*(-0.00000027557319223985891L+z*0.00000000208767569878681L)))));
    int q=((int)quadrant%4+4)%4;
    return q==0?float2((float)sn,(float)cs):q==1?float2((float)cs,(float)-sn):q==2?float2((float)-sn,(float)-cs):float2((float)-cs,(float)sn);
}
float4 Rotation(float angle)
{
    precise float halfAngle=angle*0.01745329238474369*.5;
    precise float2 sc=RotationSinCos(halfAngle);
    precise float qz=sc.x,qw=sc.y;
    precise float norm2=qz*qz+qw*qw;
    precise float norm=sqrt(norm2);
    // sqrt(1-2^-24) is just below the midpoint to 1. D3D's sqrt
    // approximation may round up; CPU Mathf.Sqrt rounds to 1-2^-24.
    if(asuint(norm2)==0x3f7fffff) norm=norm2;
    qz/=norm; qw/=norm;
    precise float twiceZ=qz*2;
    return float4(qz,qw,qw*twiceZ,1-qz*twiceZ);
}
float4 ImageRotation(float angle)
{
    precise float halfAngle=angle*0.01745329238474369*.5;
    precise float2 sc=RotationSinCos(halfAngle);
    // Transform's native normalization rounds both products before the dot
    // sum. Managed Quaternion.Normalize keeps a wider intermediate instead.
    precise float norm2=sc.x*sc.x+sc.y*sc.y;
    precise float norm=sqrt(norm2);
    if(asuint(norm2)==0x3f7fffff)norm=norm2;
    if(asuint(norm2)==0x3f800001)norm=1;
    precise float qz=CpuQuotient(sc.x,norm),qw=CpuQuotient(sc.y,norm);
    precise float twiceZ=qz*2;
    return float4(qz,qw,qw*twiceZ,1-qz*twiceZ);
}
[numthreads(64,1,1)]
void ImageRotationProbe(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x;if(i>=_Count)return;
    _RotationOut[i]=ImageRotation(_Probe[i].x);
}
[numthreads(64,1,1)]
void RotationProbe(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x; if(i>=_Count) return;
    _RotationOut[i]=Rotation(_Probe[i].x);
}
float Value(uint slot)
{
    Anchor a=_Anchors[slot];
    if(_UseAnchors!=0 && a.valid!=0)
    {
        Segment s=a.segment; if(s.duration==0) return s.end;
        float t=_Progress[a.clock];
        if(t>=s.duration) return s.end;
        if(t<=0) return s.start;
        precise float change=s.target-s.start;
        // Match the CPU runtime's single-rounding start+change*ease expression.
        // Forcing a separate float product changes large cancelling endpoints.
        return mad(change,Ease(s.ease,t,s.duration,s.over,s.period),s.start);
    }
    Track h=_Tracks[slot]; uint lo=0, hi=h.count;
    while(lo<hi) { uint mid=lo+(hi-lo)/2; if(Delta(_Segments[h.first+mid])>=0) lo=mid+1; else hi=mid; }
    if(lo==0) return h.initial;
    Segment s=_Segments[h.first+lo-1];
    if(s.duration==0) return s.end;
    float t=Delta(s)/_Pitch*_TweenScale;
    if(t>=s.duration) return s.end;
    if(t<=0) return s.start;
    precise float change=(s.scale!=0 ? s.target : s.end)-s.start;
    return mad(change,Ease(s.ease,t,s.duration,s.over,s.period),s.start);
}
[numthreads(64,1,1)]
void LinearProbe(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x; if(i>=_Count) return;
    _ProbeOut[i]=_Probe[i].x/_Probe[i].y;
}
[numthreads(64,1,1)]
void EaseProbe(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x; if(i>=_Count) return;
    float4 p=_Probe[i]; _ProbeOut[i]=Ease(_ProbeIds[i],p.x,p.y,p.z,p.w);
}
void WriteVerticesAt(uint i, float v[16], uint outputItem, bool collapse)
{
    float4 color=float4(v[7],v[8],v[9],v[10]*v[11]);
    if(collapse && color.a<=0)
    {
        // 안 보이는 장식: 면적 0 삼각형만 쓰고 FP64 계산과 버퍼 읽기를 건너뛴다(화면 결과 같음).
        [unroll] for(uint z=0;z<4;z++)_Vertices.Store3((outputItem*4+z)*60u,uint3(0,0,0));
        return;
    }
    uint b=i*10; float4 c=_Static[b+7], crop=_Static[b+8]; uint flags=(uint)crop.w;
    precise float2 trueScale=c.xy, camScale=((flags&1)!=0 ? _Camera.w : 1)*trueScale;
    precise float2 position=float2(v[0],v[1]);
    // Match the separate float operations of scrParallax.SetTrans. Fusing the
    // multiply/add loses the game's rounding at large cancelling coordinates.
    precise float2 world=(_Camera.xy-position)*float2(v[12],v[13])+position;
    if((flags&4)!=0) world.x=position.x;
    if((flags&8)!=0) world.y=position.y;
    world+=float2(v[14],v[15])*camScale/c.zw;
    precise float2 offset=(float2(v[2],v[3])+crop.xy)/trueScale;
    precise float3 translated=_Static[b+4].xyz+_Static[b+5].xyz*offset.x+_Static[b+6].xyz*offset.y;
    precise float angle=_Static[b+9].x+v[4]+((flags&2)!=0 ? _Camera.z : 0);
    // Unity rotates points through Quaternion.Euler's half-angle quaternion.
    // Full-angle sincos rounds differently at 180 degrees; wide sprites amplify it.
    precise float4 rotation=Rotation(angle);
    if((flags&64u)!=0)rotation=ImageRotation(angle);
    precise float sn=rotation.z, cs=rotation.w;
    precise float2 scale=float2(v[5],v[6])*camScale;
    uint ib=i*8u;
    precise float3 q0=0,q1=0,q2=0,q3=0;
    if((flags&64u)!=0)
    {
        // 모서리 k 와 무관한 값은 한 번만 계산한다(식은 그대로).
        // Compose TRS columns before multiplying the original sprite point.
        // The legacy path instead scales an already transformed point.
        precise float3 p0=float3(cs*scale.x,sn*scale.x,0);
        precise float3 p1=float3(-sn*scale.y,cs*scale.y,0);
        precise float3 p2=float3(0,0,1);
        precise float3 f0=_ImageShape[ib].xyz,f1=_ImageShape[ib+1].xyz,f2=_ImageShape[ib+2].xyz;
        q0=(p0*f0.x+p1*f0.y)+p2*f0.z;
        q1=(p0*f1.x+p1*f1.y)+p2*f1.z;
        q2=(p0*f2.x+p1*f2.y)+p2*f2.z;
        precise float2 exactOffset=float2(CpuQuotient(v[2]+crop.x,trueScale.x),CpuQuotient(v[3]+crop.y,trueScale.y));
        precise float3 origin=_ImageShape[ib+3].xyz+_Static[b+4].xyz+_Static[b+5].xyz*exactOffset.x+_Static[b+6].xyz*exactOffset.y;
        precise float3 exactWorld=float3((_Camera.xy-position)*float2(v[12],v[13])+position,crop.z);
        if((flags&4u)!=0)exactWorld.x=position.x;
        if((flags&8u)!=0)exactWorld.y=position.y;
        exactWorld.x+=CpuQuotient(v[14]*camScale.x,c.z);
        exactWorld.y+=CpuQuotient(v[15]*camScale.y,c.w);
        q3=((p0*origin.x+p1*origin.y)+p2*origin.z)+exactWorld;
    }
    float4 drawColor=color,info0=0,info1=0;
    if(collapse)
    {
        precise float4 scaled=saturate(color)*255.0;
        drawColor=floor(scaled+0.5)/255.0;
        info0=_CollapseTexture[i*2]; // binding+point flag, slice, UV scale
        info1=_CollapseTexture[i*2+1]; // scale XY, half texel XY
    }
    precise float3 wp[4];
    [unroll] for(uint k=0;k<4;k++)
    {
        precise float3 worldPoint;
        if((flags&64u)!=0)
        {
            precise float3 corner=_ImageShape[ib+4u+k].xyz;
            worldPoint=((q0*corner.x+q1*corner.y)+q2*corner.z)+q3;
        }
        else
        {
            precise float3 local=_Static[b+k].xyz+translated; local.xy*=scale;
            worldPoint=float3(world+float2(cs*local.x-sn*local.y,sn*local.x+cs*local.y),crop.z+local.z);
        }
        wp[k]=worldPoint;
    }
    if(collapse && _CameraClip.z>0)
    {
        // 네 모서리가 모두 카메라 화면의 같은 쪽 바깥이면 픽셀이 하나도 안 찍히므로 면적 0 으로 만든다.
        float mnX=1e30,mxX=-1e30,mnY=1e30,mxY=-1e30;
        [unroll] for(uint c2=0;c2<4;c2++)
        {
            float2 rel=wp[c2].xy-_Camera.xy;
            float cx=rel.x*_CameraClip.x+rel.y*_CameraClip.y,cy=-rel.x*_CameraClip.y+rel.y*_CameraClip.x;
            mnX=min(mnX,cx);mxX=max(mxX,cx);mnY=min(mnY,cy);mxY=max(mxY,cy);
        }
        if(mxX<-_CameraClip.z||mnX>_CameraClip.z||mxY<-_CameraClip.w||mnY>_CameraClip.w)
        {
            [unroll] for(uint z=0;z<4;z++)_Vertices.Store3((outputItem*4+z)*60u,uint3(0,0,0));
            return;
        }
    }
    [unroll] for(uint k=0;k<4;k++)
    {
        precise float3 worldPoint=wp[k];
        uint address=(outputItem*4+k)*(collapse?60u:36u);
        if(collapse)
        {
            _Vertices.Store3(address,asuint(worldPoint));
            _Vertices.Store4(address+12,asuint(drawColor));
            _Vertices.Store4(address+28,asuint(float4(_UV[i*4+k],info0.xy)));
            _Vertices.Store4(address+44,asuint(info1));
        }
        else
        {
            _Vertices.Store3(address,asuint(worldPoint));
            _Vertices.Store4(address+12,asuint(color));
            _Vertices.Store2(address+28,asuint(_UV[i*4+k]));
        }
    }
}
void WriteVerticesFromChannels(uint i, float v[16]) { WriteVerticesAt(i,v,i,false); }
[numthreads(64,1,1)]
void EvaluateCollapse(uint3 thread:SV_DispatchThreadID)
{
    uint slot=thread.x;if(slot>=_CollapseCount)return;
    uint i=_CollapseMap[slot];float v[16];
    // 알파 두 채널을 먼저 읽어 안 보이면 나머지 채널·FP64 계산을 건너뛴다.
    [unroll] for(uint ac=10;ac<12;ac++)
    {
        LiveChannel lc=_LiveChannels[i*16+ac];
        precise double value=lc.sourceIndex<0 ? (double)lc.end
            : (double)lc.start+(double)lc.change*(double)_SourceE[lc.sourceIndex];
        v[ac]=(float)value;_Values[i*16+ac]=v[ac];
    }
    if(!(v[10]*v[11]>0))
    {
        [unroll] for(uint z=0;z<4;z++)_Vertices.Store3((slot*4+z)*60u,uint3(0,0,0));
        return;
    }
    [unroll] for(uint ch=0;ch<16;ch++)
    {
        if(ch==10||ch==11)continue;
        LiveChannel lc=_LiveChannels[i*16+ch];
        precise double value=lc.sourceIndex<0 ? (double)lc.end
            : (double)lc.start+(double)lc.change*(double)_SourceE[lc.sourceIndex];
        v[ch]=(float)value;_Values[i*16+ch]=v[ch];
    }
    WriteVerticesAt(i,v,slot,true);
}
[numthreads(64,1,1)]
void Evaluate(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x; if(i>=_Count) return;
    float v[16];
    [unroll] for(uint ch=0;ch<16;ch++) { v[ch]=Value(i*16+ch); _Values[i*16+ch]=v[ch]; }
    WriteVerticesFromChannels(i,v);
}
[numthreads(64,1,1)]
void EvaluateLive(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x; if(i>=_Count) return;
    float v[16];
    if(_AlphaEarlyOut!=0)
    {
        [unroll] for(uint ac=10;ac<12;ac++)
        {
            LiveChannel lc=_LiveChannels[i*16+ac];
            precise double value=lc.sourceIndex<0 ? (double)lc.end
                : (double)lc.start+(double)lc.change*(double)_SourceE[lc.sourceIndex];
            v[ac]=(float)value;_Values[i*16+ac]=v[ac];
        }
        if(!(v[10]*v[11]>0))
        {
            [unroll] for(uint z=0;z<4;z++)_Vertices.Store3((i*4+z)*36u,uint3(0,0,0));
            return;
        }
    }
    [unroll] for(uint ch=0;ch<16;ch++) {
        if(_AlphaEarlyOut!=0 && (ch==10||ch==11))continue;
        LiveChannel lc=_LiveChannels[i*16+ch];
        precise double value=lc.sourceIndex<0 ? (double)lc.end
            : (double)lc.start+(double)lc.change*(double)_SourceE[lc.sourceIndex];
        v[ch]=(float)value; _Values[i*16+ch]=v[ch];
    }
    WriteVerticesFromChannels(i,v);
}
[numthreads(64,1,1)]
void EvaluateImageLive(uint3 thread:SV_DispatchThreadID)
{
    uint i=thread.x; if(i>=_Count) return;
    float v[16];
    if(_AlphaEarlyOut!=0)
    {
        [unroll] for(uint ac=10;ac<12;ac++)
        {
            LiveChannel lc=_LiveChannels[i*16+ac];
            precise double value=lc.sourceIndex<0 ? (double)lc.end
                : (double)lc.start+(double)lc.change*(double)_SourceE[lc.sourceIndex];
            v[ac]=(float)value;_Values[i*16+ac]=v[ac];
        }
        if(!(v[10]*v[11]>0))
        {
            [unroll] for(uint z=0;z<4;z++)_Vertices.Store3((i*4+z)*36u,uint3(0,0,0));
            return;
        }
    }
    [unroll] for(uint ch=0;ch<16;ch++) {
        if(_AlphaEarlyOut!=0 && (ch==10||ch==11))continue;
        LiveChannel lc=_LiveChannels[i*16+ch];
        precise double value=lc.sourceIndex<0 ? (double)lc.end
            : (double)lc.start+(double)lc.change*(double)_SourceE[lc.sourceIndex];
        v[ch]=(float)value; _Values[i*16+ch]=v[ch];
    }
    WriteVerticesFromChannels(i,v);
}
// A Unity Mesh owns its vertex buffer. D3D11 cannot bind 1,000 UAVs to one
// dispatch; this diagnostic measures a pre-recorded GPU copy per run instead.
void CopyVertex(uint i,uint source)
{
    uint src=source*36, dst=i*36;
    _Vertices.Store4(dst,_CopySource.Load4(src));
    _Vertices.Store4(dst+16,_CopySource.Load4(src+16));
    _Vertices.Store(dst+32,_CopySource.Load(src+32));
    // SpriteRenderer's draw color is UNorm8 even when its logical color is a
    // float. Keep evaluation/G0 unrounded; match that conversion only in the
    // draw copy, retaining the 36-byte Float32 layout used by the game shader.
    if (_CopyQuantizeColor != 0)
    {
        float4 color=asfloat(_CopySource.Load4(src+12));
        precise float4 scaled=saturate(color)*255.0;
        _Vertices.Store4(dst+12,asuint(floor(scaled+0.5)/255.0));
    }
}
[numthreads(64,1,1)]
void CopyRun(uint3 thread:SV_DispatchThreadID)
{
    if(thread.x<_CopyVertexCount)CopyVertex(thread.x,_CopyFirstVertex+thread.x);
}
StructuredBuffer<uint> _CopyMap;
[numthreads(64,1,1)]
void CopyMappedRun(uint3 thread:SV_DispatchThreadID)
{
    if(thread.x<_CopyVertexCount)CopyVertex(thread.x,_CopyMap[thread.x]);
}

// 텍스처의 불투명(알파>0) 칸의 최소·최대 좌표. 그룹마다 모아 전역 원자 연산은 그룹당 한 번만 쓴다.
Texture2D<float4> _TrimTex;
RWStructuredBuffer<uint> _TrimOut; // minX, minY, maxX, maxY
uint2 _TrimSize;
groupshared uint gTrim[4];
[numthreads(16,16,1)]
void AlphaBounds(uint3 id:SV_DispatchThreadID, uint gi:SV_GroupIndex)
{
    if(gi==0){gTrim[0]=0xFFFFFFFF;gTrim[1]=0xFFFFFFFF;gTrim[2]=0;gTrim[3]=0;}
    GroupMemoryBarrierWithGroupSync();
    if(id.x<_TrimSize.x && id.y<_TrimSize.y && _TrimTex.Load(int3(id.xy,0)).a>0)
    {
        InterlockedMin(gTrim[0],id.x);InterlockedMin(gTrim[1],id.y);
        InterlockedMax(gTrim[2],id.x);InterlockedMax(gTrim[3],id.y);
    }
    GroupMemoryBarrierWithGroupSync();
    if(gi==0 && gTrim[2]>=gTrim[0] && gTrim[0]!=0xFFFFFFFF)
    {
        InterlockedAdd(_TrimOut[4],1); // 불투명 칸이 하나라도 있는 16x16 덩어리 수
        InterlockedMin(_TrimOut[0],gTrim[0]);InterlockedMin(_TrimOut[1],gTrim[1]);
        InterlockedMax(_TrimOut[2],gTrim[2]);InterlockedMax(_TrimOut[3],gTrim[3]);
    }
}
